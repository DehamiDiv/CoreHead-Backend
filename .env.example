# AI API Keys
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=corehead_blog
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DATABASE_URL="postgresql://postgres:your_db_password_here@localhost:5432/corehead_blog"

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:3000

# Transactional Email (Resend HTTPS API)
# Use onboarding@resend.dev only for initial tests sent to your Resend account email.
# For real users, verify your domain in Resend and use an address on that domain.
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="CoreHead CMS <no-reply@your-verified-domain.com>"

# Initial platform administrator (used by: npm run seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_NAME=CoreHead Administrator

# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key_here
