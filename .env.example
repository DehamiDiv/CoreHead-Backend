# CoreHead Backend — copy to .env and fill values

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/corehead?schema=public

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_access_secret
REFRESH_TOKEN_SECRET=change_me_refresh_secret

# ─── Frontend URL (invite / reset links in emails) ────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Email (team invites, OTP, password reset) ────────────────────────────────
# Use either EMAIL_* or SMTP_* names (both supported).
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=you@gmail.com
# EMAIL_PASS=your_app_password
# EMAIL_FROM=CoreHead <noreply@yourdomain.com>
# EMAIL_SECURE=false
#
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
#
# If unset in development, Ethereal test SMTP is used (preview URL in server logs).

# ─── AI providers (optional — layout generation) ──────────────────────────────
# GROQ_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
