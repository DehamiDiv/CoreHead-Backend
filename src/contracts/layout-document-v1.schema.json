{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corehead.dev/contracts/layout-document-v1.schema.json",
  "title": "CoreHead LayoutDocument v1",
  "description": "Canonical persisted and rendered layout contract for manual and AI-generated CoreHead templates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "name", "blocks"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "enum": ["single-post", "blog-archive", "home-page"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/block" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "maxLength": 1000 },
        "designStyle": { "type": "string", "maxLength": 100 },
        "origin": { "enum": ["manual", "ai", "imported", "migrated"] }
      }
    }
  },
  "$defs": {
    "bindingPath": {
      "enum": [
        "post.title",
        "post.excerpt",
        "post.content",
        "post.contentHtml",
        "post.contentText",
        "post.coverImage",
        "post.featured_image",
        "post.category",
        "post.slug",
        "post.author.name",
        "post.publishedAt",
        "site.name",
        "site.slug",
        "site.logo",
        "site.description",
        "site.tagline",
        "site.heroImage"
      ]
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": { "$ref": "#/$defs/bindingPath" }
      }
    },
    "styleValue": { "type": ["string", "number"] },
    "styles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": { "$ref": "#/$defs/styleValue" },
        "backgroundColor": { "$ref": "#/$defs/styleValue" },
        "fontSize": { "$ref": "#/$defs/styleValue" },
        "fontWeight": { "$ref": "#/$defs/styleValue" },
        "fontStyle": { "$ref": "#/$defs/styleValue" },
        "textAlign": { "$ref": "#/$defs/styleValue" },
        "textTransform": { "$ref": "#/$defs/styleValue" },
        "lineHeight": { "$ref": "#/$defs/styleValue" },
        "letterSpacing": { "$ref": "#/$defs/styleValue" },
        "margin": { "$ref": "#/$defs/styleValue" },
        "marginTop": { "$ref": "#/$defs/styleValue" },
        "marginRight": { "$ref": "#/$defs/styleValue" },
        "marginBottom": { "$ref": "#/$defs/styleValue" },
        "marginLeft": { "$ref": "#/$defs/styleValue" },
        "padding": { "$ref": "#/$defs/styleValue" },
        "paddingTop": { "$ref": "#/$defs/styleValue" },
        "paddingRight": { "$ref": "#/$defs/styleValue" },
        "paddingBottom": { "$ref": "#/$defs/styleValue" },
        "paddingLeft": { "$ref": "#/$defs/styleValue" },
        "width": { "$ref": "#/$defs/styleValue" },
        "height": { "$ref": "#/$defs/styleValue" },
        "minHeight": { "$ref": "#/$defs/styleValue" },
        "maxWidth": { "$ref": "#/$defs/styleValue" },
        "border": { "$ref": "#/$defs/styleValue" },
        "borderColor": { "$ref": "#/$defs/styleValue" },
        "borderWidth": { "$ref": "#/$defs/styleValue" },
        "borderStyle": { "$ref": "#/$defs/styleValue" },
        "borderRadius": { "$ref": "#/$defs/styleValue" },
        "display": { "$ref": "#/$defs/styleValue" },
        "justifyContent": { "$ref": "#/$defs/styleValue" },
        "alignItems": { "$ref": "#/$defs/styleValue" },
        "gap": { "$ref": "#/$defs/styleValue" },
        "gridTemplateColumns": { "$ref": "#/$defs/styleValue" },
        "objectFit": { "$ref": "#/$defs/styleValue" },
        "opacity": { "$ref": "#/$defs/styleValue" }
      }
    },
    "baseBlockProperties": {
      "id": { "type": "string", "minLength": 1, "maxLength": 100 },
      "parentId": { "type": "string", "minLength": 1, "maxLength": 100 },
      "styles": { "$ref": "#/$defs/styles" },
      "bindings": { "$ref": "#/$defs/bindings" }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/headingBlock" },
        { "$ref": "#/$defs/paragraphBlock" },
        { "$ref": "#/$defs/imageBlock" },
        { "$ref": "#/$defs/quoteBlock" },
        { "$ref": "#/$defs/dividerBlock" },
        { "$ref": "#/$defs/buttonBlock" },
        { "$ref": "#/$defs/containerBlock" },
        { "$ref": "#/$defs/columnsBlock" },
        { "$ref": "#/$defs/collectionListBlock" },
        { "$ref": "#/$defs/featuredCarouselBlock" },
        { "$ref": "#/$defs/videoBlock" },
        { "$ref": "#/$defs/newsletterBlock" },
        { "$ref": "#/$defs/socialLinksBlock" },
        { "$ref": "#/$defs/spacerBlock" },
        { "$ref": "#/$defs/codeBlock" },
        { "$ref": "#/$defs/htmlBlock" },
        { "$ref": "#/$defs/markdownBlock" }
      ]
    },
    "headingBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/baseBlockProperties/id" },
        "type": { "const": "Heading" },
        "content": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["text"],
              "properties": {
                "text": { "type": "string" },
                "level": { "type": "integer", "minimum": 1, "maximum": 3 }
              }
            }
          ]
        },
        "level": { "type": "integer", "minimum": 1, "maximum": 3 },
        "parentId": { "$ref": "#/$defs/baseBlockProperties/parentId" },
        "styles": { "$ref": "#/$defs/styles" },
        "bindings": { "$ref": "#/$defs/bindings" }
      }
    },
    "paragraphBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/baseBlockProperties/id" },
        "type": { "const": "Paragraph" },
        "content": { "oneOf": [{ "type": "string" }, { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" } }, "additionalProperties": false }] },
        "parentId": { "$ref": "#/$defs/baseBlockProperties/parentId" },
        "styles": { "$ref": "#/$defs/styles" },
        "bindings": { "$ref": "#/$defs/bindings" }
      }
    },
    "imageBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/baseBlockProperties/id" },
        "type": { "const": "Image" },
        "content": { "oneOf": [{ "type": "string" }, { "type": "object", "required": ["src"], "properties": { "src": { "type": "string" }, "alt": { "type": "string" } }, "additionalProperties": false }] },
        "parentId": { "$ref": "#/$defs/baseBlockProperties/parentId" },
        "styles": { "$ref": "#/$defs/styles" },
        "bindings": { "$ref": "#/$defs/bindings" }
      }
    },
    "quoteBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/baseBlockProperties/id" },
        "type": { "const": "Quote" },
        "content": { "oneOf": [{ "type": "string" }, { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" }, "attribution": { "type": "string" } }, "additionalProperties": false }] },
        "parentId": { "$ref": "#/$defs/baseBlockProperties/parentId" },
        "styles": { "$ref": "#/$defs/styles" },
        "bindings": { "$ref": "#/$defs/bindings" }
      }
    },
    "dividerBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/baseBlockProperties/id" },
        "type": { "const": "Divider" },
        "content": { "const": "" },
        "parentId": { "$ref": "#/$defs/baseBlockProperties/parentId" },
        "styles": { "$ref": "#/$defs/styles" }
      }
    },
    "buttonBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/baseBlockProperties/id" },
        "type": { "const": "Button" },
        "content": { "type": "object", "required": ["text", "url"], "properties": { "text": { "type": "string" }, "url": { "type": "string" } }, "additionalProperties": false },
        "parentId": { "$ref": "#/$defs/baseBlockProperties/parentId" },
        "styles": { "$ref": "#/$defs/styles" },
        "bindings": { "$ref": "#/$defs/bindings" }
      }
    },
    "containerBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/baseBlockProperties/id" },
        "type": { "const": "Container" },
        "content": { "const": "" },
        "parentId": { "$ref": "#/$defs/baseBlockProperties/parentId" },
        "styles": { "$ref": "#/$defs/styles" }
      }
    },
    "columnsBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/baseBlockProperties/id" },
        "type": { "const": "Columns" },
        "content": { "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 4 }, { "type": "object", "required": ["columns"], "properties": { "columns": { "type": "integer", "minimum": 1, "maximum": 4 } }, "additionalProperties": false }] },
        "parentId": { "$ref": "#/$defs/baseBlockProperties/parentId" },
        "styles": { "$ref": "#/$defs/styles" }
      }
    },
    "collectionListBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/baseBlockProperties/id" },
        "type": { "const": "Collection List" },
        "content": { "type": "object", "required": ["limit", "category"], "properties": { "limit": { "type": "integer", "minimum": 1, "maximum": 50 }, "category": { "type": "string", "maxLength": 100 } }, "additionalProperties": false },
        "parentId": { "$ref": "#/$defs/baseBlockProperties/parentId" },
        "styles": { "$ref": "#/$defs/styles" }
      }
    },
    "featuredCarouselBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/baseBlockProperties/id" },
        "type": { "const": "Featured Carousel" },
        "content": { "type": "object", "required": ["limit"], "properties": { "limit": { "type": "integer", "minimum": 1, "maximum": 20 } }, "additionalProperties": false },
        "parentId": { "$ref": "#/$defs/baseBlockProperties/parentId" },
        "styles": { "$ref": "#/$defs/styles" }
      }
    },
    "videoBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/baseBlockProperties/id" },
        "type": { "const": "Video" },
        "content": { "oneOf": [{ "type": "string" }, { "type": "object", "required": ["url"], "properties": { "url": { "type": "string" }, "title": { "type": "string" } }, "additionalProperties": false }] },
        "parentId": { "$ref": "#/$defs/baseBlockProperties/parentId" },
        "styles": { "$ref": "#/$defs/styles" }
      }
    },
    "newsletterBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/baseBlockProperties/id" },
        "type": { "const": "Newsletter" },
        "content": { "type": "object", "required": ["title", "description", "buttonText", "placeholder"], "properties": { "title": { "type": "string" }, "description": { "type": "string" }, "buttonText": { "type": "string" }, "placeholder": { "type": "string" } }, "additionalProperties": false },
        "parentId": { "$ref": "#/$defs/baseBlockProperties/parentId" },
        "styles": { "$ref": "#/$defs/styles" }
      }
    },
    "socialLinksBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/baseBlockProperties/id" },
        "type": { "const": "Social Links" },
        "content": { "type": "object", "required": ["links"], "properties": { "links": { "type": "array", "maxItems": 20, "items": { "type": "object", "required": ["name", "url"], "properties": { "name": { "type": "string" }, "url": { "type": "string" } }, "additionalProperties": false } } }, "additionalProperties": false },
        "parentId": { "$ref": "#/$defs/baseBlockProperties/parentId" },
        "styles": { "$ref": "#/$defs/styles" }
      }
    },
    "spacerBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/baseBlockProperties/id" },
        "type": { "const": "Spacer" },
        "content": { "oneOf": [{ "type": "string" }, { "type": "number", "minimum": 0, "maximum": 1000 }, { "type": "object", "required": ["height"], "properties": { "height": { "oneOf": [{ "type": "string" }, { "type": "number", "minimum": 0, "maximum": 1000 }] } }, "additionalProperties": false }] },
        "parentId": { "$ref": "#/$defs/baseBlockProperties/parentId" },
        "styles": { "$ref": "#/$defs/styles" }
      }
    },
    "codeBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/baseBlockProperties/id" },
        "type": { "const": "Code Block" },
        "content": { "type": "object", "required": ["code", "language"], "properties": { "code": { "type": "string", "maxLength": 100000 }, "language": { "type": "string", "maxLength": 50 } }, "additionalProperties": false },
        "parentId": { "$ref": "#/$defs/baseBlockProperties/parentId" },
        "styles": { "$ref": "#/$defs/styles" }
      }
    },
    "htmlBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/baseBlockProperties/id" },
        "type": { "const": "Html" },
        "content": { "oneOf": [{ "type": "string", "maxLength": 100000 }, { "type": "object", "required": ["html"], "properties": { "html": { "type": "string", "maxLength": 100000 } }, "additionalProperties": false }] },
        "parentId": { "$ref": "#/$defs/baseBlockProperties/parentId" },
        "styles": { "$ref": "#/$defs/styles" },
        "bindings": { "$ref": "#/$defs/bindings" }
      }
    },
    "markdownBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/baseBlockProperties/id" },
        "type": { "const": "Markdown" },
        "content": { "oneOf": [{ "type": "string", "maxLength": 100000 }, { "type": "object", "required": ["markdown"], "properties": { "markdown": { "type": "string", "maxLength": 100000 } }, "additionalProperties": false }] },
        "parentId": { "$ref": "#/$defs/baseBlockProperties/parentId" },
        "styles": { "$ref": "#/$defs/styles" },
        "bindings": { "$ref": "#/$defs/bindings" }
      }
    }
  }
}
